    "def solveIceEquation(h, h_prime, v, time):\n",
    "    ML_Ice, MR_Ice = iceDensity(h, h_prime, v) # fix this function\n",
    "    G = massBal(h, h_prime, time, v) # change timestep if needed idk if this is right\n",
    "    RHS = MR_Ice @ h + v['dt'] * G\n",
    "    # need to apply boundary conditions \n",
    "    RHS[0] = 0\n",
    "    RHS[-1] = RHS[-2]\n",
    "    h_updated = np.linalg.inv(ML_Ice) @ RHS  # this math might be wrong, check later\n",
    "    h_updated = np.maximum(h_updated, 0.0)  # Ice can't be negative\n",
    "    return h_updated\n"
