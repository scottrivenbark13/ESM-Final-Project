    "    values['r'] = 0.3\n",
    "    values['k'] = 17\n",
    "    values['nu'] = 100\n",
    "    values['v'] = 100000 * 1000 # km2 / yr, converted to meters \n",
    "\n",
    "    values['dx'] = (74-30) / (numberPoints - 1)\n",
